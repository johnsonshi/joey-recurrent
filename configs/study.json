  "loop_screen": [
    {"k": 2, "method": "damped_extra", "alpha": 0.25},
    {"k": 3, "method": "damped_extra", "alpha": 0.1},
    {"k": 3, "method": "rk", "beta": 0.5},
    {"k": 3, "method": "euler"}
