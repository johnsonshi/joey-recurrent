# Default-deny at the workspace root. Admit portable project material explicitly.
/*
!/.gitignore
!/README.md
!/pyproject.toml
!/src/
!/tests/
!/configs/
!/benchmarks/
!/scripts/
!/docs/
!/locks/

/.scratch/
/docs/x-thread.md
# Keep editable .excalidraw.json scenes; the image exports are local working files.
/docs/figures/*.excalidraw
/docs/figures/*.png
/docs/figures/*.svg
.research/
local-config/
joey-research-handoff/
01_MASTER_PROMPT.md
02_CONVERSATION_RECORD.md
03_SOURCES.md
RESEARCH_HANDOFF.html
LAUNCH_PROMPT.md
*.zip
*.tar
*.tar.*
*.whl
*.local.env
.env
.env.*
kubeconfig
*.kubeconfig
credentials.json
secrets.yaml
*.pem
*.key
*.pfx
.azure/
.aws/
.ssh/
.kube/
artifacts/
checkpoints/
results/
outputs/
runs/
logs/
profiles/
datasets/
downloads/
test-artifacts/
.agent-state/
.agent-logs/
.agent-worktrees/
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
*.bin
*.parquet
*.arrow
*.log
*.sqlite*
__pycache__/
*.py[cod]
.venv/
venv/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
